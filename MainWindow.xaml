<Window x:Class="MediaFetch.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediaFetch"
        Height="420"
        Width="620"
        WindowStartupLocation="CenterScreen">

	<Grid Margin="32">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<TextBlock Text="MediaFetch"
                   FontSize="28"
                   FontWeight="SemiBold" />

		<TextBlock Grid.Row="1"
                   Margin="0,8,0,20"
                   Text="Download public media you have permission to save."
                   Foreground="Gray" />

		<TextBox x:Name="UrlTextBox"
                 Grid.Row="2"
                 Height="38"
                 Padding="10"
                 FontSize="14"
                 VerticalContentAlignment="Center"
                 ToolTip="Paste a video URL here"
				 TextChanged="UrlTextBox_TextChanged" />

		<StackPanel Grid.Row="3"
                    Margin="0,16,0,0"
                    Orientation="Horizontal">
			<ComboBox x:Name="FormatComboBox"
                      Width="140"
                      Height="36"
                      SelectedIndex="0">
				<ComboBoxItem Content="MP4 video" Tag="video:mp4" />
				<ComboBoxItem Content="MKV video" Tag="video:mkv" />
				<ComboBoxItem Content="WebM video" Tag="video:webm" />
				<ComboBoxItem Content="MOV video" Tag="video:mov" />
				<ComboBoxItem Content="Original audio" Tag="audio:original" />
				<ComboBoxItem Content="MP3 audio" Tag="audio:mp3" />
				<ComboBoxItem Content="M4A audio" Tag="audio:m4a" />
				<ComboBoxItem Content="Opus audio" Tag="audio:opus" />
				<ComboBoxItem Content="FLAC audio" Tag="audio:flac" />
				<ComboBoxItem Content="WAV audio" Tag="audio:wav" />
			</ComboBox>

			<ComboBox x:Name="QualityComboBox"
                      Width="130"
                      Height="36"
                      Margin="12,0,0,0"
                      IsEnabled="False">
				<ComboBoxItem Content="Waiting for link..."
                  IsSelected="True" />
			</ComboBox>

			<Button x:Name="DownloadButton"
                    Width="140"
                    Height="36"
                    Margin="12,0,0,0"
                    Content="Download"
					Click="DownloadButton_Click" />
		</StackPanel>

		<StackPanel Grid.Row="4"
            Margin="0,12,0,0"
            Orientation="Horizontal">
			<Button Width="140"
					Height="32"
					Content="Choose folder"
					Click="ChooseFolderButton_Click" />

			<TextBlock x:Name="FolderText"
					   Margin="12,0,0,0"
					   VerticalAlignment="Center"
					   Text="No folder selected"
					   Foreground="Gray"
					   TextTrimming="CharacterEllipsis" />
		</StackPanel>

		<StackPanel Grid.Row="5"
                    Margin="0,24,0,0">
			<TextBlock x:Name="MediaInfoText"
					   Margin="0,0,0,6"
					   Foreground="Gray"
					   Text="Source audio: waiting for link" />
			<TextBlock  x:Name="StatusText"
				        Text="Status: Ready" />
			<ProgressBar Height="12"
                         Margin="0,8,0,0"
                         Minimum="0"
                         Maximum="100"
                         Value="0" />
		</StackPanel>
	</Grid>
</Window>
