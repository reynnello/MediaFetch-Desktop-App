<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>MediaFetch</AssemblyName>
    <Product>MediaFetch</Product>
    <ApplicationIcon>Assets\MediaFetch.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	  <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\MediaFetch.ico" />
    <Resource Include="Assets\MediaFetch.Icon.png" />
  </ItemGroup>

</Project>
